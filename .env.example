# ===== 大密扣升压站进度监控系统 · 自有服务器环境配置 =====
# 使用方法：cp .env.example .env ，然后修改下面的值

# MySQL 数据库连接串（必填）
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 腾讯云数据库MySQL（CDB）示例：
#   mysql://dmk_user:YourPassword@10.0.0.5:3306/dmk_progress
# 云服务器自建MySQL（与本机同机）示例：
#   mysql://dmk_user:YourPassword@127.0.0.1:3306/dmk_progress
DATABASE_URL=mysql://dmk_user:YourPassword@127.0.0.1:3306/dmk_progress

# 会话签名密钥（必填）：一串足够长的随机字符串，可用以下命令生成：
#   openssl rand -hex 32
APP_SECRET=please-change-me-to-a-long-random-string

# 服务端口（可选，默认3000）
PORT=3000

# 初始管理员账号（可选，仅首次执行 npm run db:seed-users 时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Dmk@2026admin
ADMIN_NAME=系统管理员
